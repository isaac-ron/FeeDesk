# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# docker-compose reads variables from this .env file automatically

# MongoDB (used by docker-compose)
MONGO_USERNAME=admin
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT (REQUIRED — docker-compose will refuse to start without this)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64

# M-PESA Daraja API (Safaricom)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=your_paybill_or_till_number
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/stkcallback
API_BASE_URL=https://yourdomain.com
MPESA_IP_WHITELIST_ENABLED=false

# TextSMS Kenya SMS API
TEXTSMS_API_KEY=your_api_key
TEXTSMS_PARTNER_ID=your_partner_id
TEXTSMS_SHORTCODE=SCHOOLPAY

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:80,http://localhost:3000

# Frontend Configuration
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
