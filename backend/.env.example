# Server Configuration
NODE_ENV=development
PORT=3000

# Database
MONGO_URI=mongodb://localhost:27017/schoolpay-enterprise
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/schoolpay?retryWrites=true&w=majority

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# JWT Secret (Generate a random string)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# M-PESA Daraja API (Safaricom)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=your_paybill_or_till_number
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/stkcallback
API_BASE_URL=https://yourdomain.com

# Safaricom IP Whitelist (set to true in production)
MPESA_IP_WHITELIST_ENABLED=false
# SAFARICOM_IPS=196.201.214.,196.201.212.

# TextSMS Kenya SMS API
TEXTSMS_API_KEY=your_api_key
TEXTSMS_PARTNER_ID=your_partner_id
TEXTSMS_SHORTCODE=SCHOOLPAY

# Fee Reminder Cron (default: Mon & Thu at 8 AM EAT)
# FEE_REMINDER_CRON=0 8 * * 1,4

# ============================================
# Bank Integrations
# ============================================

# Global enforcement for bank webhook signature validation.
# Leave `false` during sandbox testing so unsigned IPNs are accepted with a
# warning. Flip to `true` in production once each school has its webhook
# secret / public key configured.
BANK_WEBHOOK_SIGNATURE_REQUIRED=false

# --- KCB BUNI (https://sandbox.buni.kcbgroup.com) ---
KCB_API_URL=https://uat.buni.kcbgroup.com
# Production: https://buni.kcbgroup.com
KCB_CONSUMER_KEY=bcSTMk9oXjrKW5p_xSfgs6nOxn0a
KCB_CONSUMER_SECRET=fpjC3HObts1y5CDqS7tfVKKFrbga
# KCB public key (PEM) used to verify SHA256withRSA IPN signatures.
# Paste the full PEM block with escaped newlines, e.g.:
#   KCB_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
# Get this from the BUNI portal — KCB signs with their private key, we verify.
KCB_PUBLIC_KEY=

# --- Equity Jenga / Finserve (https://developer.jengahq.io) ---
EQUITY_API_URL=https://uat.finserve.africa
# Production: https://api.finserve.africa
JENGA_USERNAME=user
JENGA_PASSWORD=pass
JENGA_API_KEY=your_jenga_api_key
# RSA private key used to sign outgoing Jenga requests (PEM format, escape
# newlines as \n for .env or mount a file and reference its contents).
JENGA_PRIVATE_KEY=
# Jenga public key used to verify incoming IPN signatures.
JENGA_PUBLIC_KEY=

# --- Co-op Bank (placeholder — manual onboarding) ---
# COOP_API_URL=https://developer.co-opbank.co.ke:9443